# Copy this file to ".env" and adjust. NEVER commit the real ".env" file.

PORT=3000
NODE_ENV=development

# MongoDB connection string (local MongoDB or a free Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/daily-web

# Long random string used to sign the session cookie and the device cookie.
# Must stay the same between server restarts so users remain logged in.
SESSION_SECRET=replace-with-a-long-random-string

# OpenWeatherMap (free plan, no credit card): https://openweathermap.org/api
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv
# Optional override of the upstream URL (used for testing only)
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Password given to every demo user created by "npm run seed"
SEED_PASSWORD=choose-a-password
